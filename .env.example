# Garmin Connect credentials (never commit the real .env file)
GARMIN_EMAIL=you@example.com
GARMIN_PASSWORD=your-password

# Optional overrides
# Directory where the cached OAuth session (garth) is stored between runs
GARMIN_TOKEN_DIR=.garmin_tokens
# Path to the SQLite database file
GARMIN_DB_PATH=data/garmin.db
# Number of days to pull on a full backfill (default 365 = ~12 months)
GARMIN_BACKFILL_DAYS=365

# Optional: hosted Turso DB instead of the local SQLite file (used for the
# cloud sync/dashboard setup - leave unset for local-only use)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional: daily coach email (see README "Daily coach email" section)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
TO_EMAIL=
DASHBOARD_URL=

# Optional: password gate for the deployed dashboard (unset = no gate)
DASHBOARD_PASSWORD=

# Phase 3: Anthropic Claude API key for the LLM coach layer (unused until then)
ANTHROPIC_API_KEY=
